# VyaparX environment configuration
ENVIRONMENT=production

# PostgreSQL
POSTGRES_USER=vyaparx_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=vyaparx_db
DATABASE_URL=postgresql://vyaparx_user:replace-with-a-strong-password@localhost:5432/vyaparx_db

# JWT - generate two independent secrets (32+ characters each)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# First platform administrator
BOOTSTRAP_ADMIN=true
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Administrator

# Frontend origins; comma-separated or JSON array
CORS_ORIGINS=["http://localhost:3000"]

# ML assets
ML_MODELS_DIR=./ml_models
